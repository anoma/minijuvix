module Input;

axiom Int : Type;

compile Int {
  c ↦ "int";
};


axiom String : Type;

compile String {
  c ↦ "char*";
};

axiom to-str : Int → String;

compile to-str {
  c ↦ "intToStr";
};

axiom Action : Type;

compile Action {
  c ↦ "int";
};

axiom put-str-ln : String → Action;

compile put-str-ln {
  c ↦ "putStrLn";
};

foreign c {
  int cplus(int l, int r) {
    return l + r;
  \}
};


axiom plus : Int → Int → Int;

compile plus {
  c ↦ "cplus";
};

apply : (Int → Int → Int) → Int → Int → Int;
apply f a b ≔ f a b;

main : Action;
main ≔ put-str-ln (to-str (apply plus 1 2));

end;
