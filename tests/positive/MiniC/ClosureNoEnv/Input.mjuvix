module Input;

import IO;
open IO;

import String;
open String;

axiom Int : Type;

compile Int {
  c ↦ "int";
};

axiom to-str : Int → String;

compile to-str {
  c ↦ "intToStr";
};

foreign c {
  int cplus(int l, int r) {
    return l + r;
  \}
};

axiom plus : Int → Int → Int;

compile plus {
  c ↦ "cplus";
};

apply : (Int → Int → Int) → Int → Int → Int;
apply f a b ≔ f a b;

inductive Nat {
  zero : Nat;
  suc : Nat → Nat;
};

applyNat : (Nat → Nat) → Nat → Nat;
applyNat f a ≔ f a;

nat-to-int : Nat → Int;
nat-to-int zero ≔ 0;
nat-to-int (suc n) ≔ plus 1 (nat-to-int n);

one : Nat;
one ≔ suc zero;

two : Nat;
two ≔ suc one;

main : Action;
main ≔ put-str "plus 1 2: "
        >> put-str-ln (to-str (apply plus 1 2))
        >> put-str "suc one: "
        >> put-str-ln (to-str (nat-to-int (applyNat suc one)));

end;
